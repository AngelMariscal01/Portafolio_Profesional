---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { experience } from '../content/experience';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section
  id="experiencia"
  index="02"
  eyebrow={t('sectionExperience')}
  title={t('sectionExperienceLead')}
>
  <ol>
    {
      experience.map((role, i) => (
        <li class="reveal border-t border-line last:border-b">
          <details class="group" open={i === 0}>
            <summary class="cursor-pointer list-none py-6 [&::-webkit-details-marker]:hidden">
              <div class="grid gap-x-8 gap-y-2 md:grid-cols-[9rem_1fr_auto] md:items-baseline">
                <p class="tnum text-sm text-subtle">
                  {role.start} — {role.end[lang]}
                </p>

                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="text-lg tracking-tight md:text-xl">{role.title[lang]}</h3>
                    {role.current && <span class="chip chip-accent">{t('currentBadge')}</span>}
                  </div>
                  <p class="mt-1 text-sm text-muted">
                    {role.company} · {role.kind[lang]} · {role.location[lang]}
                  </p>
                  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
                    {role.summary[lang]}
                  </p>
                </div>

                <span class="hidden text-subtle transition-transform duration-300 group-open:rotate-180 md:block">
                  <Icon name="arrow-down" size={16} />
                </span>
              </div>
            </summary>

            <div class="grid gap-x-8 pb-8 md:grid-cols-[9rem_1fr_auto]">
              <div class="hidden md:block" />
              <div class="min-w-0 max-w-2xl">
                <h4 class="eyebrow">{t('labelHighlights')}</h4>
                <ul class="mt-3 space-y-2.5">
                  {role.highlights[lang].map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-muted">
                      <span class="mt-2 h-px w-3 shrink-0 bg-line-strong" aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>

                <h4 class="eyebrow mt-6">{t('labelStack')}</h4>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {role.stack.map((tech) => (
                    <li class="chip">{tech}</li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</Section>
