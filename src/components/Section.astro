---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}

const { id, index, eyebrow, title, lead, class: className = '' } = Astro.props;
---

<section id={id} class={`scroll-mt-24 py-16 md:py-24 ${className}`} aria-labelledby={`${id}-title`}>
  <div class="container-page">
    <header class="reveal mb-10 md:mb-14">
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="eyebrow eyebrow-accent tnum">{index}</span>
        <span class="eyebrow">{eyebrow}</span>
      </div>
      <h2 id={`${id}-title`} class="mt-6 max-w-3xl text-[1.75rem] leading-snug md:text-[2.25rem]">
        {title}
      </h2>
      {lead && <p class="mt-3 max-w-2xl text-base text-muted">{lead}</p>}
    </header>
    <slot />
  </div>
</section>
