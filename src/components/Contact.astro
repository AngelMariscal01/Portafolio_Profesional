---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { profile } from '../content/profile';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const channels = [
  {
    icon: 'mail' as const,
    label: t('contactEmail'),
    value: profile.contact.email,
    href: `mailto:${profile.contact.email}`,
    copy: profile.contact.email,
  },
  {
    icon: 'linkedin' as const,
    label: 'LinkedIn',
    value: profile.contact.linkedinLabel,
    href: profile.contact.linkedin,
    external: true,
  },
  {
    icon: 'github' as const,
    label: 'GitHub',
    value: profile.contact.githubLabel,
    href: profile.contact.github,
    external: true,
  },
  {
    icon: 'phone' as const,
    label: t('contactPhone'),
    value: profile.contact.phone,
    href: profile.contact.phoneHref,
    copy: profile.contact.phone,
  },
];
---

<Section id="contacto" index="06" eyebrow={t('sectionContact')} title={t('sectionContactLead')}>
  <div class="grid gap-4 lg:grid-cols-[1fr_1.1fr] lg:gap-6">
    <div class="reveal card p-6 md:p-8">
      <h3 class="font-serif text-2xl leading-snug md:text-[1.75rem]">
        {
          lang === 'es'
            ? '¿Construimos algo con IA que sí llegue a producción?'
            : 'Shall we build AI that actually ships?'
        }
      </h3>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-muted md:text-base">
        {
          lang === 'es'
            ? 'Estoy abierto a roles remotos en LATAM y México, y a colaboraciones puntuales en sistemas agénticos. Respondo correos el mismo día.'
            : 'I am open to remote roles across LATAM and Mexico, and to focused collaborations on agentic systems. I answer email the same day.'
        }
      </p>

      <div class="mt-7 flex flex-wrap gap-2.5">
        <a href={`mailto:${profile.contact.email}`} class="btn btn-primary">
          <Icon name="mail" size={16} />
          {t('heroCtaContact')}
        </a>
        <a href={profile.cv[lang]} download class="btn btn-ghost">
          <Icon name="download" size={16} />
          {t('heroCtaCv')}
        </a>
      </div>

      <p class="mt-7 flex items-center gap-2 text-xs text-subtle">
        <Icon name="pin" size={14} />
        {profile.location[lang]}
      </p>
    </div>

    <ul class="reveal grid gap-3 sm:grid-cols-2">
      {
        channels.map((channel) => (
          <li class="card card-interactive group relative flex items-center gap-4 p-4">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded border border-line text-subtle">
              <Icon name={channel.icon} size={17} />
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-xs text-subtle">{channel.label}</p>
              <a
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
                class="block truncate text-sm font-medium after:absolute after:inset-0 after:content-['']"
              >
                {channel.value}
              </a>
            </div>
            {channel.copy && (
              <button
                type="button"
                data-copy={channel.copy}
                data-copy-label={t('contactCopy')}
                data-copied-label={t('contactCopied')}
                aria-label={`${t('contactCopy')} ${channel.label}`}
                class="relative z-10 rounded border border-line px-2 py-1 text-[0.65rem] uppercase tracking-wider text-subtle opacity-0 transition-opacity hover:border-accent hover:text-accent focus-visible:opacity-100 group-hover:opacity-100"
              >
                {t('contactCopy')}
              </button>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        var value = btn.getAttribute('data-copy') || '';
        var done = function () {
          btn.textContent = btn.getAttribute('data-copied-label') || 'Copied';
          setTimeout(function () {
            btn.textContent = btn.getAttribute('data-copy-label') || 'Copy';
          }, 1600);
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(value).then(done).catch(function () {});
          return;
        }
        // Fallback for non-secure contexts, where the Clipboard API is unavailable.
        var field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        document.body.appendChild(field);
        field.select();
        try {
          document.execCommand('copy');
          done();
        } catch (e) {
          /* nothing else to try */
        }
        document.body.removeChild(field);
      });
    });
  })();
</script>
