---
import Section from './Section.astro';
import { skillGroups } from '../content/skills';
import { useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="skills" index="04" eyebrow={t('sectionSkills')} title={t('sectionSkillsLead')}>
  <dl>
    {
      skillGroups.map((group) => (
        <div class="reveal grid gap-x-8 gap-y-2 border-t border-line py-5 last:border-b md:grid-cols-[13rem_1fr]">
          <dt
            class:list={[
              'text-sm font-medium',
              group.primary ? 'text-accent' : 'text-ink',
            ]}
          >
            {group.title[lang]}
          </dt>
          <dd class="text-sm leading-relaxed text-muted">
            {group.items.join(' · ')}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
