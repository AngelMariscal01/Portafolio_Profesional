---
import Icon from './Icon.astro';
import { navItems } from '../content/site';
import { profile } from '../content/profile';
import { localizePath, otherLang, useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = otherLang(lang);
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent-contrast"
>
  {t('skipToContent')}
</a>

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
  data-header
>
  <div
    class="absolute inset-0 -z-10 opacity-0 backdrop-blur-xl transition-opacity duration-300 data-[on]:opacity-100"
    style="background-color: var(--bg-veil);"
    data-header-veil
  >
  </div>

  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <a
      href={localizePath('/', lang)}
      class="group flex items-center gap-2.5 text-sm font-semibold tracking-tight"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded border border-line text-[0.7rem] font-medium tracking-wide text-accent transition-colors group-hover:border-accent"
      >
        {profile.initials}
      </span>
      <span class="hidden sm:inline">{profile.shortName}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-nav-link={item.id}
              class="rounded px-3 py-2 text-sm text-muted transition-colors hover:text-ink data-[active]:text-accent"
            >
              {item.label[lang]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <a
        href={localizePath('/', alt)}
        hreflang={alt}
        aria-label={t('switchLangAria')}
        class="hidden items-center gap-1.5 rounded border border-line px-2.5 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent sm:inline-flex"
      >
        <Icon name="globe" size={14} />
        {alt.toUpperCase()}
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-label={t('themeToggle')}
        class="grid h-9 w-9 place-items-center rounded border border-line text-muted transition-colors hover:border-accent hover:text-accent"
      >
        <span data-theme-icon="dark" class="hidden"><Icon name="moon" size={16} /></span>
        <span data-theme-icon="light" class="hidden"><Icon name="sun" size={16} /></span>
      </button>

      <a
        href={profile.cv[lang]}
        download
        class="btn btn-primary hidden !px-3.5 !py-2 !text-xs md:inline-flex"
      >
        <Icon name="download" size={14} />
        CV
      </a>

      <button
        type="button"
        data-menu-open
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-9 w-9 place-items-center rounded border border-line text-muted transition-colors hover:border-accent hover:text-accent lg:hidden"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </nav>
</header>

<dialog
  id="mobile-menu"
  class="m-0 h-full max-h-none w-full max-w-none bg-bg p-0 text-ink backdrop:bg-black/60 lg:hidden"
>
  <div class="container-page flex h-16 items-center justify-between">
    <span class="eyebrow">{t('menu')}</span>
    <button
      type="button"
      data-menu-close
      aria-label={t('close')}
      class="grid h-9 w-9 place-items-center rounded-md border border-line text-muted"
    >
      <Icon name="x" size={18} />
    </button>
  </div>

  <div class="container-page pb-10">
    <ul class="flex flex-col">
      {
        navItems.map((item, i) => (
          <li class="border-b border-line">
            <a
              href={`#${item.id}`}
              data-menu-link
              class="flex items-baseline gap-4 py-5 text-2xl tracking-tight"
            >
              <span class="eyebrow tnum">{String(i + 1).padStart(2, '0')}</span>
              {item.label[lang]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href={profile.cv[lang]} download class="btn btn-primary">
        <Icon name="download" size={16} />
        {t('heroCtaCv')}
      </a>
      <a href={localizePath('/', alt)} hreflang={alt} class="btn btn-ghost">
        <Icon name="globe" size={16} />
        {t('switchLang')}
      </a>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    // Header gains a veil once the page scrolls away from the hero.
    var header = document.querySelector('[data-header]');
    var veil = document.querySelector('[data-header-veil]');
    function onScroll() {
      var scrolled = window.scrollY > 24;
      if (veil) veil.toggleAttribute('data-on', scrolled);
      if (header) header.classList.toggle('border-line', scrolled);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Theme toggle. The resolved theme is already on <html> from Layout.
    function paintThemeIcons() {
      var current = document.documentElement.dataset.theme;
      document.querySelectorAll('[data-theme-icon]').forEach(function (el) {
        el.classList.toggle('hidden', el.dataset.themeIcon === current);
      });
    }
    paintThemeIcons();
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* private mode: the choice just will not persist */
        }
        paintThemeIcons();
      });
    });

    // Mobile menu, on top of <dialog> so focus trapping and Escape are native.
    var menu = document.getElementById('mobile-menu');
    var openBtn = document.querySelector('[data-menu-open]');
    if (menu && openBtn) {
      var close = function () {
        menu.close();
      };
      openBtn.addEventListener('click', function () {
        menu.showModal();
        openBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      });
      menu.addEventListener('close', function () {
        openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
      menu.querySelectorAll('[data-menu-close], [data-menu-link]').forEach(function (el) {
        el.addEventListener('click', close);
      });
    }
  })();
</script>
